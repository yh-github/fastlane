    "physicalDoctorChancePerPoint": 0.05,
    "lowSpiritsThreshold": 10,
    "lowSpiritsChancePerPoint": 0.05,
    "workGrindThreshold": 4,
    "workGrindMentalCost": 1,
    "workPhysicalCost": 1,
